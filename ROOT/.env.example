# ---------------------------------------------------------------------------
# Supabase (REQUIRED)
# ---------------------------------------------------------------------------
# All shared data (players, test results, testers, staff, announcements and
# server config) lives in Supabase. Without these two values the app still
# builds and renders, but every database feature reports
# "Supabase not configured" and nothing is shared between devices.
#
# Locally, put them in .env.local (git-ignored -- never commit that file).
# On Vercel, set both in Project -> Settings -> Environment Variables for
# Production, Preview AND Development, then redeploy. Vite inlines VITE_*
# values at build time, so existing builds will not pick up changes.
#
# Use the PUBLISHABLE key (sb_publishable_...), never the service_role secret.
# The publishable key is safe to ship in client code; access is restricted by
# your Row Level Security policies.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Bot API  (server-side only)
# ---------------------------------------------------------------------------
# Two endpoints, both authenticated with the same BOT_API_SECRET header
# (`x-bot-secret`), both doing their writes with SUPABASE_SERVICE_ROLE_KEY.
#
#   POST /api/accounts   one account at a time
#                       create | sync | rank | get | delete
#
#   POST /api/sync       whole-dataset push (the bot is source of truth)
#                       collections: accounts, players, testResults,
#                                     testers, staff
#                       + "dryRun": true to preview without writing
#                       + "replace": true AND "confirmReplace": true to
#                         delete records missing from the payload
#
# !! DO NOT put SUPABASE_SERVICE_ROLE_KEY in a VITE_* variable. Anything
# !! VITE_ prefixed is inlined into the client bundle at build time and
# !! would ship full database access to every visitor. The key belongs only
# !! in server-side environment variables.
#
# The bot itself only needs the endpoint URL + BOT_API_SECRET. Never give it
# the service_role key.
#
# `announcements` and `server_config` are intentionally NOT writable through
# /api/sync -- manage those from the admin panel.
#
# Generate a secret with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
BOT_API_SECRET=replace-with-a-long-random-string
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# ---------------------------------------------------------------------------
# Discord (optional)
# ---------------------------------------------------------------------------
# Optional: Custom Discord Webhook URL override
# If left unset, Bedrock Union uses the secure obfuscated fallback webhook.
# VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
